{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "api-runtime/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "webapi/**",
          "engine/**",
          "mcts/**",
          "agents/**",
          "schemas/**",
          "config/**",
          "analytics/**",
          "data/**",
          "arena_runs/**/summary.json",
          "__init__.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api-runtime/app.py" },
    { "src": "/health", "dest": "/api-runtime/app.py" },
    { "src": "/docs", "dest": "/api-runtime/app.py" },
    { "src": "/openapi.json", "dest": "/api-runtime/app.py" },
    {
      "src": "/blokus_core.zip",
      "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
