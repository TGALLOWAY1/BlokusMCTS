# VITE_API_URL — OPTIONAL.
#   Leave UNSET for same-origin deployments (e.g. Vercel): the app then calls the
#   API via relative `/api/...` paths, which Vercel routes to the Python function.
#   Set it ONLY when the backend lives on a different origin (cross-origin).
#   For local dev it points the Vite proxy at the local backend.
# VITE_API_URL=http://localhost:8000
# VITE_APP_PROFILE=deploy  # Uncomment for simplified deploy UI (4-player Human vs MCTS only)
# VITE_ENABLE_DEBUG_UI=true  # Uncomment to show Debug/Logs tab in right panel (for in-game telemetry)
