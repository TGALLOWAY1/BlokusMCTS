# Production build settings (Vite loads this only for `vite build`).
# Overrides the dev values in .env so a production deploy never inherits them.
#
# Deploy profile: simplified public UI (gameplay + in-browser MCTS only),
# research routes/pages gated off.
VITE_APP_PROFILE=deploy
# Empty = same-origin relative API calls. Vercel same-origin rewrites route
# /api/* to the serverless function, so no absolute origin is needed and there
# are no CORS preflights. Set this to a full https origin only for a
# cross-origin API deployment.
VITE_API_URL=
# Debug/Logs telemetry tab stays off in the public production build.
VITE_ENABLE_DEBUG_UI=false
